NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://executive_connect:executive_connect@localhost:5432/executive_connect?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_MODE=MOCK
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
TEST_ALLOWED_NUMBERS=
# Encrypts WhatsApp secrets entered in the dashboard (optional; derived from JWT_SECRET when empty)
SETTINGS_ENCRYPTION_KEY=
APP_TIMEZONE=Asia/Dubai
DAILY_SEND_TIME=09:00
SEND_POLICY=AUTO
INBOUND_MODE=STORE_ONLY
MINIMUM_IMPORT_AGE_MINUTES=30
LEAP_DAY_POLICY=FEB_28
MESSAGE_BATCH_SIZE=10
MESSAGE_RATE_PER_SECOND=5
# Optional failure-alert emails (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
VITE_API_URL=http://localhost:8000/api
